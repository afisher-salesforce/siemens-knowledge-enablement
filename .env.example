# ─── Siemens DISW KM site — environment ───────────────────────────────
# Copy to .env for local dev. In production, set these as Heroku config vars.
# NEVER commit .env. Secrets live only in Heroku config vars.

# Salesforce OAuth (client-credentials flow) — reuse the HAV live org's ECA
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce org (HAV live org My Domain)
SF_INSTANCE_URL=https://storm-db63fb470328c9.my.salesforce.com
SF_LOGIN_URL=https://storm-db63fb470328c9.my.salesforce.com
SF_API_VER=v62.0

# Agentforce Agent API — KM-grounded agent (DISW_Support_Assistant deployed to HAV org)
# SF_AGENT_ID is the BotDefinition Id captured after `sf agent publish authoring-bundle`.
SF_AGENT_ID=0XxWt000000wwbVKAQ
SF_AGENT_API_HOST=https://api.salesforce.com

# Write gate — mirrors the hav MCP ALLOW_WRITES pattern.
# When false (default), the draft-article proof returns TEXT ONLY and never
# creates a Draft Knowledge__kav record in the live org.
ALLOW_KM_WRITES=false

# Server port (Heroku sets this automatically)
PORT=3001
