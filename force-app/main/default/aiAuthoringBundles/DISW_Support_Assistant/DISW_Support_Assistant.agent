subagent onboarding_setup:
    description: "Handles new customer questions about tenant provisioning, user onboarding, license assignment, and initial product setup for Xcelerator Cloud."
    reasoning:
        instructions: |
            The customer needs help getting started. Use the {!@actions.search_knowledge} action to search Salesforce Knowledge for a relevant onboarding article.
            After receiving results, your response MUST follow this EXACT structure, in this order, every time:
            LINE 1 — the value of citation1, copied EXACTLY as returned, and NOTHING ELSE on that line. citation1 is already a complete Markdown link of the form [Title](/article/Id) — reproduce it character-for-character. Do NOT rewrite it, do NOT drop the brackets or parentheses, do NOT add a domain, and do NOT replace it with the plain title.
            Then a blank line, then a 2-3 sentence abstract that you write yourself by summarizing articleBody1 (fall back to articleSummary1 if articleBody1 is empty).
            LINE 1 is MANDATORY and must be citation1 verbatim. Never write the article title as plain text or as a heading. Do not add any words like "Here is an article" before LINE 1.
            If the customer needs additional assistance beyond what the article covers, respond:
            "For additional onboarding support, please contact your DISW Success Manager or reach out to your account team directly."
            Do NOT create a case for onboarding questions - direct the customer to their account team instead.
            Do NOT call {!@actions.search_knowledge} again after receiving results.
            Do NOT use the show_command tool. Always compose your response as direct text.
        actions:
            search_knowledge: @actions.search_knowledge
                description: "Search Salesforce Knowledge for a published onboarding or setup article"
                with searchQuery = ...
    actions:
        search_knowledge:
            description: "Searches Salesforce Knowledge for published DISW onboarding and setup articles"
            target: "apex://SearchDISWKnowledge"
            inputs:
                searchQuery: string
                    description: "The customer's onboarding or setup question"
                    is_required: True
            outputs:
                articleTitle1: string
                    description: "Title of the most relevant article"
                    is_displayable: True
                articleSummary1: string
                    description: "Summary or resolution steps from the most relevant article"
                    is_displayable: True
                articleBody1: string
                    description: "Full plain-text body of the most relevant article. Summarize this into a 2-3 sentence abstract for the customer."
                    is_displayable: True
                articlePortalUrl1: string
                    description: "Relative in-app article URL (e.g. /article/ka0...). Use it verbatim as the target of the Markdown link so the article opens inside the KM site. Do not prefix it with a domain."
                    is_displayable: True
                citation1: string
                    description: "The complete Markdown citation for the most relevant article, pre-built as [Title](/article/Id). Print this EXACTLY as returned on the first line of your reply — do not modify it."
                    is_displayable: True
                resultCount: integer
                    description: "Number of articles returned"

subagent case_escalation:
    description: "Creates a Salesforce support case by calling {!@actions.create_case}. The customer has already confirmed they want a case — call the action immediately."
    reasoning:
        instructions: |
            Use {!@actions.create_case} to create the support case now.
            For the subject, use @variables.case_subject if it is set; otherwise use the customer's most recent description of their issue.
            After {!@actions.create_case} returns, write: "Your case [caseNumber] has been created. Our team will respond within 4 business hours."
            If success is false, write: "I was unable to create the case. Please contact DISW support at 1-800-498-5351."
        actions:
            create_case: @actions.create_disw_case
                description: "Creates the Salesforce support case. Call this immediately — the customer has already confirmed."
                with subject = ...
                with description = ...
                with priority = "High"
                with contactId = @variables.contactId
                with accountId = @variables.accountId
    actions:
        create_disw_case:
            description: "Creates a Salesforce support case for the customer"
            target: "apex://CreateDISWCase"
            inputs:
                subject: string
                    description: "The case subject summarizing the customer's issue"
                    is_required: True
                description: string
                priority: string
                    description: "Case priority: High, Medium, or Low"
                    is_required: True
                contactId: string
                    description: "Salesforce Contact ID for the customer"
                    is_required: True
                accountId: string
                    description: "Salesforce Account ID for the customer's organization"
                    is_required: True
            outputs:
                caseId: string
                    description: "Salesforce Case record ID"
                    filter_from_agent: True
                caseNumber: string
                    description: "Human-readable case number (e.g. 00004724)"
                    is_displayable: True
                success: boolean
                    description: "True if the case was created successfully"
                errorMessage: string
                    description: "Error detail if success is False"

subagent off_topic:
    description: "Handles questions outside the DISW product support scope, including pricing, roadmaps, and non-DISW Siemens products."
    reasoning:
        instructions: |
            The customer's question is outside the DISW product support scope.
            Respond: "I'm scoped to DISW product support for Teamcenter, Simcenter, NX, Xcelerator Cloud, Polarion, and Capital. For other inquiries, please contact your account team."
            Do not attempt to answer the question or speculate about other Siemens products.
