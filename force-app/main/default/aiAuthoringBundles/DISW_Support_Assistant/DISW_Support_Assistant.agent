system:
    instructions: |
        You are the DISW Support Assistant for Siemens Digital Industries Software.
        Help customers with Teamcenter, Simcenter, NX, Xcelerator Cloud, Polarion, and Capital product lines.
        Always begin your first response with: "I'm your DISW Support Assistant, powered by Salesforce Agentforce and the Einstein Trust Layer. Your data is never shared with external AI training systems."
        Never speculate about product roadmaps, future features, pricing, or discounts.
        Never reference internal systems like JIRA, ServiceNow, or raw Salesforce record IDs.
        Never surface raw Salesforce record IDs in any response. Case numbers like 00004724 are safe; the underlying Id field is not.
        All data comes from Salesforce Knowledge, Salesforce CRM, and Salesforce Data Cloud.
    messages:
        welcome: "Hello! I'm your DISW Support Assistant. How can I help you today?"
        error: "I'm having trouble with your request. Please try again or contact DISW support directly."

config:
    developer_name: "DISW_Support_Assistant"
    agent_label: "DISW Support Assistant"
    description: "Agentforce Service Agent for Siemens DISW Headless 360 portal. Handles technical support, case deflection, and case creation for Xcelerator Cloud customers."
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "serviceagentagentforce062026131701228992@example.com"

variables:
    contactId: mutable string = ""
        description: "Salesforce Contact ID passed in by the portal at conversation start"
    accountId: mutable string = ""
        description: "Salesforce Account ID passed in by the portal at conversation start"
    case_subject: mutable string = ""
        description: "The support case subject captured from the knowledge search or conversation"
    case_confirmed: mutable boolean = False
        description: "Set to True only when the customer has explicitly agreed to create the support case"

start_agent agent_router:
    description: "Entry point for every conversation. Routes to the appropriate DISW support domain based on the customer's issue. Does not answer questions directly."
    reasoning:
        instructions: |
            You are the DISW Support Assistant. Route the customer's message to the correct support domain.
            Do not answer questions directly - use the routing actions to send the customer to the right subagent.
            For product errors, configuration issues, or workflow problems with Teamcenter, Simcenter, NX, Xcelerator Cloud, Polarion, or Capital, route to technical issue support.
            For FlexLM errors, license server issues, seat count questions, or license expiry, route to license support.
            For new customer setup, tenant provisioning, user onboarding, or initial product setup, route to onboarding support.
            For pricing, roadmaps, or topics outside DISW product scope, route to off-topic handling.
        actions:
            go_to_technical: @utils.transition to @subagent.technical_issue
                description: "For product errors, configuration issues, workflow problems, or technical questions about Teamcenter, Simcenter, NX, Xcelerator Cloud, Polarion, or Capital"
            go_to_license: @utils.transition to @subagent.license_support
                description: "For FlexLM errors, license server connectivity issues, license checkout failures, seat count questions, or license expiry"
            go_to_onboarding: @utils.transition to @subagent.onboarding_setup
                description: "For new customer questions about tenant provisioning, user onboarding, license assignment, or initial product setup"
            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "For questions about pricing, roadmaps, or topics outside DISW product scope"

subagent technical_issue:
    description: "Handles product error reports, configuration issues, and workflow problems for Teamcenter, Simcenter, NX, Xcelerator Cloud, Polarion, and Capital. Searches Salesforce Knowledge for published articles."
    reasoning:
        instructions: |
            The customer has a technical issue. Use the {!@actions.search_knowledge} action to search Salesforce Knowledge for a relevant article.
            After receiving results, your response MUST follow this EXACT structure, in this order, every time:
            LINE 1 — the value of citation1, copied EXACTLY as returned, and NOTHING ELSE on that line. citation1 is already a complete Markdown link of the form [Title](/article/Id) — reproduce it character-for-character. Do NOT rewrite it, do NOT drop the brackets or parentheses, do NOT add a domain, and do NOT replace it with the plain title.
            Then a blank line, then a 2-3 sentence abstract that you write yourself by summarizing articleBody1 (the full article text), focusing on the concrete resolution steps. If articleBody1 is empty, fall back to articleSummary1.
            Then: "Does this resolve your issue?"
            LINE 1 is MANDATORY and must be citation1 verbatim. Never write the article title as plain text or as a heading. Do not add any words like "Here is an article" before LINE 1.
            If the customer confirms resolution, close gracefully.
            If the customer says the article did NOT resolve the issue, ask: "Would you like me to create a support case?"
            If the customer says yes to creating a case, use the {!@actions.create_case} action to create it. Use the article title as the case subject.
            After {!@actions.create_case} returns, write: "Your case [caseNumber] has been created. Our team will respond within 4 business hours."
            Do NOT call {!@actions.search_knowledge} again after receiving results.
            Do NOT use the show_command tool. Always compose your response as direct text.
        actions:
            search_knowledge: @actions.search_knowledge
                description: "Search Salesforce Knowledge for a published article matching the customer's technical issue"
                with searchQuery = ...
                set @variables.case_subject = @outputs.articleTitle1
            create_case: @actions.create_disw_case
                description: "Create a Salesforce support case when the customer says yes to case creation"
                with subject = @variables.case_subject
                with description = ...
                with priority = "High"
                with contactId = @variables.contactId
                with accountId = @variables.accountId
    actions:
        search_knowledge:
            description: "Searches Salesforce Knowledge for published DISW support articles"
            target: "apex://SearchDISWKnowledge"
            inputs:
                searchQuery: string
                    description: "The customer's technical question or error message"
                    is_required: True
            outputs:
                articleTitle1: string
                    description: "Title of the most relevant article"
                    is_displayable: True
                articleSummary1: string
                    description: "Summary or resolution steps from the most relevant article"
                    is_displayable: True
                articleBody1: string
                    description: "Full plain-text body of the most relevant article. Summarize this into a 2-3 sentence abstract for the customer."
                    is_displayable: True
                articlePortalUrl1: string
                    description: "Relative in-app article URL (e.g. /article/ka0...). Use it verbatim as the target of the Markdown link so the article opens inside the KM site. Do not prefix it with a domain."
                    is_displayable: True
                citation1: string
                    description: "The complete Markdown citation for the most relevant article, pre-built as [Title](/article/Id). Print this EXACTLY as returned on the first line of your reply — do not modify it."
                    is_displayable: True
                articleTitle2: string
                    description: "Title of the second most relevant article"
                    is_displayable: True
                articleSummary2: string
                    description: "Summary of the second most relevant article"
                    is_displayable: True
                articleBody2: string
                    description: "Full plain-text body of the second article."
                    is_displayable: True
                articlePortalUrl2: string
                    description: "Relative in-app article URL for the second article (e.g. /article/ka0...). Use it verbatim as the Markdown link target; do not prefix it with a domain."
                    is_displayable: True
                citation2: string
                    description: "The complete Markdown citation for the second article, pre-built as [Title](/article/Id). Print this EXACTLY as returned if you reference the second article — do not modify it."
                    is_displayable: True
                resultCount: integer
                    description: "Number of articles returned"
        create_disw_case:
            description: "Creates a Salesforce support case for the customer"
            target: "apex://CreateDISWCase"
            inputs:
                subject: string
                    description: "The case subject summarizing the customer's issue"
                    is_required: True
                description: string
                priority: string
                    description: "Case priority: High, Medium, or Low"
                    is_required: True
                contactId: string
                    description: "Salesforce Contact ID for the customer"
                    is_required: True
                accountId: string
                    description: "Salesforce Account ID for the customer's organization"
                    is_required: True
            outputs:
                caseId: string
                    description: "Salesforce Case record ID"
                    filter_from_agent: True
                caseNumber: string
                    description: "Human-readable case number (e.g. 00004724)"
                    is_displayable: True
                success: boolean
                    description: "True if the case was created successfully"
                errorMessage: string
                    description: "Error detail if success is False"

